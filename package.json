{
  "name": "prompter-mchiodi",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "node server/src/index.js",
    "test": "npm test -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
